# Copy to .env.local for local dev, and set these in Vercel → Project Settings.
# NutriCook runs in DEMO MODE (session-only mock data) when the Supabase vars are absent.

# ── Frontend (must be VITE_-prefixed to reach the browser; anon key is public) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Serverless only (NEVER expose to the browser) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Optional. Enables local (no-network) verification of Supabase access tokens
# on /api/generate only — skips one round-trip per request. Trade-off: a
# revoked session stays valid here until the token naturally expires (~1hr),
# instead of being rejected instantly. Admin and checkout routes always
# verify over the network regardless of this setting. Leave unset to keep
# today's behavior (network verification everywhere). Find this value at
# Supabase Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# ── Admin API (/api/admin/*) ──
# Comma-separated emails allowed to call admin endpoints. Empty/unset = admin
# API is unavailable to everyone (fails closed).
ADMIN_EMAILS=

# ── Stripe (optional; without these, upgrading simulates instantly) ──
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
