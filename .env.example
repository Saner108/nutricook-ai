# Copy to .env.local for local dev, and set these in Vercel → Project Settings.
# NutriCook runs in DEMO MODE (session-only mock data) when the Supabase vars are absent.

# ── Frontend (must be VITE_-prefixed to reach the browser; anon key is public) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Serverless only (NEVER expose to the browser) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# ── Admin routes (optional; unset = no admins, every /api/admin/* call is denied) ──
# Comma-separated list of emails allowed to call /api/admin/*. Checked against the
# email on the caller's verified Supabase token, never against client-supplied input.
ADMIN_EMAILS=

# ── Stripe (optional; without these, upgrading simulates instantly) ──
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
